      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual é a área de entrega do delivery do Brasa Burger?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Atendemos com entrega rápida e quentinha todo o São Sebastião (Bairro São José, Bairro São Francisco, Residencial Bosque, Vila Nova, Vila do Boa, Morro da Cruz, Centro, Crixás, Capão Comprido), Jardins Mangueiral (todas as quadras de QC 01 a QC 15) e os principais condomínios do Jardim Botânico (Solar da Serra, Solar de Brasília, Jardim Botânico V, Ville de Montagne, San Diego, Quintas do Sol, Estância Quintas da Alvorada, Ouro Vermelho I e II, Belvedere Green, Jardim das Paineiras e Altiplano Leste)."
          }
        },
        {
          "@type": "Question",
          "name": "Qual o horário de funcionamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segunda a Domingo, das 19h às 23h."
          }
        },
        {
          "@type": "Question",
          "name": "Quais são as formas de pagamento aceitas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PIX, Cartão de Crédito/Débito na entrega e Dinheiro."
          }
        },
        {
          "@type": "Question",
          "name": "Como faço meu pedido?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Basta escolher seus burgers e acompanhamentos favoritos diretamente no nosso cardápio online, personalizar adicionais e ponto da carne se desejar, preencher seu endereço e enviar o pedido direto para o nosso WhatsApp já prontinho para produção!"
          }
        }
      ]
